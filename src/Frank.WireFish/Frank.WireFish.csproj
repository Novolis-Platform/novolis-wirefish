<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Frank.WireFish</PackageId>
    <IsPackable>false</IsPackable>
    <RootNamespace>Frank.WireFish</RootNamespace>
    <Description>
      WireFish captures network traffic via SharpPcap and routes packets through handlers using Novolis.Messaging.Channels.
      Register IPacketHandler implementations to process DevicePacket instances in a non-blocking, DI-friendly way.
    </Description>
    <PackageTags>network;capture;traffic;packet;wirefish;sharppcap;pcap;channels</PackageTags>
    <PackageProjectUrl>https://github.com/Novolis-Platform/novolis-wirefish</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Novolis-Platform/novolis-wirefish</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Messaging.Channels" />
    <PackageReference Include="Bitvantage.Ethernet.OuiDatabase" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="SharpPcap" />
  </ItemGroup>
</Project>
